<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.freemytv"
    android:versionCode="5"
    android:versionName="1.2.3">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- After the TV boots (and after a TV update), checks that Free My TV mode is still as you left it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Settings > Shelf > hold OK: the pictures saved on the TV, for an app's own icon. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Auto power-off: the warning's fallback overlay when the accessibility service isn't running. Granted over the
         TV's own ADB (appops) when the feature is turned on in Free My TV mode; the accessibility overlay needs none. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+: without this list the app can't "see" the other apps (getLeanbackLaunchIntentForPackage
         returns null). The shelf and streaming apps, the live TV apps and, through the <intent>, every TV app
         (for "All Apps"). -->
    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.sony.dtv.tvx" />
        <package android:name="com.nuvio.tv" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nuvio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The default process is :home (the home screen, settings, screensaver and accessibility service). Android 11
         starts a screensaver's window (DreamActivity) in the app's DEFAULT process, not the dream's: with the dream in
         :home and the default being the main process, the window never came and the TV hung "dreaming" with nothing on
         screen. The main process (the switches, the boot check) is now named explicitly below. -->
    <application
        android:name=".App"
        android:process=":home"
        android:label="Free My TV"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- The app's icon opens the settings (switch between Free My TV and the original home screen). -->
        <activity
            android:name=".SettingsActivity"
            android:process=":home"
            android:exported="true"
            android:label="Free My TV"
            android:launchMode="singleTask"
            android:taskAffinity="io.freemytv.settings"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTV.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- An app's own icon: pick a picture and crop it to the card (Settings > Shelf > hold OK). -->
        <activity
            android:name=".IconActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTV.Home" />

        <!-- The built-in IPTV player (Live TV, Home Settings > Live TV). Same process as the home screen. -->
        <activity
            android:name=".IptvActivity"
            android:process=":home"
            android:exported="false"
            android:label="Live TV"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTV.Home" />

        <!-- The home screen. Its own process (:home): if it ever crashes, the safety net in the main process still
             works. It only becomes the TV's home screen in Free My TV mode (cmd package set-home-activity). -->
        <activity
            android:name=".HomeActivity"
            android:process=":home"
            android:exported="true"
            android:label="Free My TV"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTV.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".Screensaver"
            android:process=":home"
            android:exported="true"
            android:label="Free My TV"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The switches, as background jobs in the main process. -->
        <service
            android:name=".ModeJob"
            android:process="io.freemytv"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The remote's app buttons from inside any app (Settings > Remote Buttons). Same process as the settings. -->
        <service
            android:name=".RemoteKeyService"
            android:process=":home"
            android:exported="true"
            android:label="Free My TV"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_key_service" />
        </service>

        <receiver
            android:name=".HomeReceiver"
            android:process="io.freemytv"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Auto power-off's backup alarm (brings :home back if it was killed). -->
        <receiver
            android:name=".AutoOffReceiver"
            android:process=":home"
            android:exported="false" />

        <!-- Auto power-off's warning, last resort (no accessibility service, no overlay permission). -->
        <activity
            android:name=".AutoOffActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity="io.freemytv.autooff"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/FreeMyTV.Overlay" />
    </application>
</manifest>
